# Inklara — Inclusive Engineering Platform Environment Variables

# Database: SQLite for zero-config local development, or PostgreSQL for production / Docker
# SQLite (default for local development & zero-dependency testing):
DATABASE_URL="file:./dev.db"

# PostgreSQL (production / Docker Compose):
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/inklara?schema=public"

# SSRF Security Settings
# When true, permits scanning localhost / 127.0.0.1 for local test fixtures (development only)
# In production, set to false to strictly forbid any private IP, localhost, or metadata service access
ALLOW_LOCAL_SCANNING="true"

# Scanning Engine Constraints
SCAN_TIMEOUT_MS="30000"
SCAN_MAX_CONCURRENCY="2"
SCAN_MAX_PAGES="15"
SCAN_PAGE_WAIT_UNTIL="load"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
